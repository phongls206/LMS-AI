# =============================================================================
# ETC English Center — Environment Variables Example
# Sao chép file này thành .env và điền các giá trị thực tế
# TUYỆT ĐỐI KHÔNG commit file .env lên Git
# =============================================================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=etc_user
DB_PASSWORD=etc_password
DB_NAME=etc_english

# Prisma Database URL (tự động build từ các biến trên)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# --- JWT Authentication ---
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# --- Backend Server ---
BACKEND_PORT=8000
NODE_ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Google Gemini AI ---
GEMINI_API_KEY=your-google-ai-studio-api-key-here
# Model cho tư vấn lớp và sinh bài tập (tốc độ nhanh)
GEMINI_FLASH_MODEL=gemini-1.5-flash-latest
# Model cho tóm tắt tiến độ (phân tích sâu)
GEMINI_PRO_MODEL=gemini-1.5-pro-latest
# Timeout cho mỗi lệnh gọi AI (giây)
GEMINI_TIMEOUT_SECONDS=10
