# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO DOCKER COMPOSE DEPLOYMENT
# ========================================================

# 1. Cơ sở dữ liệu PostgreSQL (Chạy trong container etc_english_db)
DB_USER=etc_user
DB_PASSWORD=etc_password_secure_2026
DB_NAME=etc_english
DB_PORT=5432

# 2. Cấu hình Backend (NestJS API Server)
PORT=8000
JWT_SECRET=etc_english_center_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=24h
FRONTEND_URL=http://localhost:3000

# 3. Khóa Google Gemini AI API (Cần điền khóa thực tế từ aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TIMEOUT_MS=30000
GEMINI_FLASH_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.1-pro

# 4. Cấu hình Frontend (Next.js Web App)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
